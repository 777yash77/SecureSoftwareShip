#!/usr/bin/env bash
# SecureShip Git Pre-Commit Hook
# Place in .git/hooks/pre-commit and chmod +x .git/hooks/pre-commit

echo "🛡️  SecureShip: Running pre-commit Shift-Left security check..."

# Get staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check if secureship CLI is installed
if ! command -v secureship &> /dev/null; then
    echo "⚠️  SecureShip CLI not found in PATH. Skipping pre-commit gate or install via: pip install ./engine"
    exit 0
fi

# Run scan on staged changes or repository with fail-on high
secureship scan . --fail-on high
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo ""
    echo "❌ Commit rejected by SecureShip Security Gate."
    echo "Please fix the High/Critical security vulnerabilities before committing,"
    echo "or suppress false positives with inline '# secureship-ignore'."
    echo ""
    exit 1
fi

echo "✅ SecureShip: Pre-commit security check passed. Proceeding with commit."
exit 0
